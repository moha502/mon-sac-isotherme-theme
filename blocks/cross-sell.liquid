<script src="{{ 'cross-sell.js' | asset_url }}" type="module"></script>

{% liquid
  assign cross_sell_products = block.settings.products

  if request.visual_preview_mode
    assign cross_sell_products = collections.all.products | where: 'available'
  endif

  assign cross_sell_size = 0
  for cross_sell_product in cross_sell_products
    assign cross_sell_size = cross_sell_size | plus: 1
    if request.visual_preview_mode and forloop.index >= 3
      break
    endif
  endfor
%}

{% if cross_sell_size > 0 %}
  <div
    class="
      cross-sell-list
      {%- if block.settings.show_on_display == 'desktop_only' %} mobile-hide{% endif -%}
      {%- if block.settings.show_on_display == 'mobile_only' %} desktop-hide{% endif -%}
      {%- if block.settings.additional_class != blank %} {{ block.settings.additional_class }}{% endif -%}
    "
    style="
      --margin-top: {{ block.settings.margin_top }}px;
      --margin-bottom: {{ block.settings.margin_bottom }}px;
      --image-width: {{ block.settings.image_width }}px;
    "
    data-ref="cross-sell-slider"
    {{ block.shopify_attributes }}
  >
    <div class="cross-sell-track{% if cross_sell_size > 1 %} cross-sell-track--slider{% endif %}" data-ref="cross-sell-track">
      {% for cross_sell_product in cross_sell_products %}
        {% liquid
          assign selected_variant = cross_sell_product.selected_or_first_available_variant
          assign product_price = selected_variant.price
          assign product_compare_at_price = selected_variant.compare_at_price
          if product_compare_at_price == blank or product_compare_at_price == 0
            assign product_compare_at_price = selected_variant.price
          endif
          assign show_dynamic_variant_image = true
          if block.settings.image != blank
            assign show_dynamic_variant_image = false
          endif
        %}
        <cross-sell-component
          data-dynamic-variant-image="{{ show_dynamic_variant_image }}"
          data-product-handle="{{ cross_sell_product.handle }}"
          class="cross-sell-slide cross-sell--{{ block.settings.display_mode }}"
          data-slide-index="{{ forloop.index0 }}"
        >
          <div class="cross-sell card{% if block.settings.show_card_border %} card--with-border{% endif %} color-{{ block.settings.color_scheme }}{% if block.settings.show_image == false %} cross-sell--no-image{% endif %}">
            {% if block.settings.show_image %}
              {% assign image_src = '' %}
              {% assign image_alt = '' %}
              {%- if block.settings.image != blank -%}
                {% assign image_src = block.settings.image %}
                {% assign image_alt = block.settings.image.alt %}
              {%- elsif selected_variant.featured_image != blank -%}
                {% assign image_src = selected_variant.featured_image %}
                {% assign image_alt = selected_variant.featured_image.alt %}
              {%- else -%}
                {% assign image_src = cross_sell_product.featured_image %}
                {% assign image_alt = cross_sell_product.featured_image.alt %}
              {%- endif -%}
              <img class="cross-sell__image" src="{{ image_src | image_url: width: 300 }}" width="100" height="auto" loading="lazy" alt="{{ image_alt }}" data-ref="cross-sell-image">
            {% endif %}
            <div class="cross-sell__content">
              <div class="cross-sell__heading">
                <div class="cross-sell__title-and-description">
                  <p class="cross-sell__title">{{ cross_sell_product.title }}</p>
                  {% if block.settings.price_position == 'below_title' %}
                    {% render 'price', price: product_price, compare_price: product_compare_at_price, sales_badge: 'none' %}
                  {% endif %}
                </div>
                {% if block.settings.price_position == 'next_to_title' %}
                  {% render 'price', price: product_price, compare_price: product_compare_at_price, sales_badge: 'none' %}
                {% endif %}
              </div>
              <div class="cross-sell__actions">
                <div class="cross-sell__selects">
                  <div class="cross-sell__select{% if cross_sell_product.variants.size == 1 %} hidden{% endif %}">
                    {% if block.settings.show_options_label %}
                      <label class="cross-sell__select-label">
                        {% for option in cross_sell_product.options_with_values %}{{ option.name }}{% unless forloop.last %} / {% else %}:{% endunless %}{% endfor %}
                      </label>
                    {% endif %}
                    <div class="select-wrapper select-wrapper--full-width">
                      <select name="cross-sell__select-{{ cross_sell_product.id }}" class="select select--full-width select--small" data-handle="{{ cross_sell_product.handle }}" data-ref="variant-select" data-price="{{ cross_sell_product.price }}" data-compare-at-price="{{ cross_sell_product.compare_at_price }}">
                        {% for variant in cross_sell_product.variants %}
                          {% if variant.available %}
                            <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare-at-price="{{ variant.compare_at_price }}"{% if variant.featured_image != blank %} data-image="{{ variant.featured_image | image_url: width: 300 }}"{% endif %}>{{ variant.title }}</option>
                          {% endif %}
                        {% endfor %}
                      </select>
                      <div class="select-wrapper__icon">{% render 'icon', icon: 'keyboard_arrow_down' %}</div>
                    </div>
                  </div>
                </div>
                <div class="cross-sell__form" data-ref="add-to-cart-form">
                  <button data-ref="add-to-cart-button" class="button button--small{% if block.settings.button_content_type == 'icon' and block.settings.price_position != 'inside_cart_add_button' %} button--icon-only{% endif %}" {% unless selected_variant.available %}disabled{% endunless %}>
                    <span class="button__content">
                      {% if block.settings.button_content_type == 'icon' %}{% render 'icon', icon: block.settings.button_content_icon %}{% else %}{{ 'products.add' | t }}{% endif %}
                      {% if block.settings.price_position == 'inside_cart_add_button' %}<span class="button__separator">|</span>{% render 'price', price: product_price, compare_price: product_compare_at_price, sales_badge: 'none' %}{% endif %}
                    </span>
                    {% render 'loading-spinner' %}
                  </button>
                </div>
              </div>
            </div>
          </div>
        </cross-sell-component>
        {% if request.visual_preview_mode and forloop.index >= 3 %}{% break %}{% endif %}
      {% endfor %}
    </div>
    {% if cross_sell_size > 1 %}
      <div class="cross-sell-dots" data-ref="cross-sell-dots">
        {% for cross_sell_product in cross_sell_products %}
          <button
            class="cross-sell-dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-ref="cross-sell-dot"
            data-slide-index="{{ forloop.index0 }}"
            aria-label="Afficher le produit {{ forloop.index }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
          {% if request.visual_preview_mode and forloop.index >= 3 %}{% break %}{% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endif %}

{% if cross_sell_size > 1 %}
  <script>
    // Slider simple pour le bloc cross-sell du cart drawer:
    // - clic sur un trait => scroll vers le slide correspondant
    // - swipe horizontal natif mobile via overflow + scroll-snap (CSS)
    // - mise à jour du trait actif selon la position de scroll
    (() => {
      const sliderRoots = document.querySelectorAll('[data-ref="cross-sell-slider"]');

      sliderRoots.forEach((root) => {
        const track = root.querySelector('[data-ref="cross-sell-track"]');
        const dots = root.querySelectorAll('[data-ref="cross-sell-dot"]');

        if (!track || dots.length <= 1) return;

        const updateActiveDot = () => {
          const slideWidth = track.clientWidth;
          if (!slideWidth) return;

          const index = Math.round(track.scrollLeft / slideWidth);

          dots.forEach((dot, dotIndex) => {
            const isActive = dotIndex === index;
            dot.classList.toggle('is-active', isActive);
            dot.setAttribute('aria-current', isActive ? 'true' : 'false');
          });
        };

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const index = Number(dot.dataset.slideIndex || 0);
            track.scrollTo({
              left: track.clientWidth * index,
              behavior: 'smooth',
            });
          });
        });

        track.addEventListener('scroll', updateActiveDot, { passive: true });
        window.addEventListener('resize', updateActiveDot);
        updateActiveDot();
      });
    })();
  </script>
{% endif %}

{% stylesheet %}
  .cross-sell-list {
    display: block;
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
    width: 100%;
  }

  .cross-sell-track {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .cross-sell-track--slider {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    flex-direction: row;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .cross-sell-track--slider::-webkit-scrollbar {
    display: none;
  }

  .cross-sell-slide {
    min-width: 100%;
    scroll-snap-align: start;
  }

  .cross-sell {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--padding-sm);
    grid-template-areas: 'image content content';
    padding: var(--cross-sell-padding);
  }

  .cart__footer .cross-sell {
    border-radius: calc(var(--card-border-radius) - (var(--card-padding) * 0.5));
  }

  .cross-sell--column .cross-sell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    .cross-sell__content,
    .cross-sell__actions,
    .cross-sell__heading {
      justify-content: center;
      align-items: center;
      flex-direction: column;
      text-align: center;
    }

    .cross-sell__content,
    .cross-sell__actions,
    .cross-sell__form,
    .cross-sell__form .button {
      min-width: 100%;
    }
  }

  .cross-sell--no-image {
    grid-template-areas: 'content content content';
  }

  .cross-sell__image {
    width: 100%;
    grid-area: image;
    max-width: var(--image-width);
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: calc(var(--card-border-radius) - var(--cross-sell-padding));
  }

  .cross-sell__content {
    grid-area: content;
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    gap: var(--padding-xs);
  }

  .cross-sell__heading {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--padding-xs);
    /* flex-wrap: wrap; */
  }

  .cross-sell__heading .prices {
    font-size: var(--font-body--size-small);
    justify-content: flex-end;
  }

  .cross-sell__title-and-description {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xxs);
  }

  .cross-sell__title {
    line-height: normal;
    font-weight: 600;
    font-size: var(--font-body--size);
    margin: 0;
  }

  .cross-sell__description p {
    margin: 0;
    /* line-height: normal; */
    font-size: var(--font-body--size-small);
  }

  .cross-sell__actions {
    display: flex;
    justify-content: flex-end;
  }

  .cross-sell__selects {
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    width: 100%;
    flex: 1;
    gap: var(--gap-xs);
  }

  .cross-sell__select-label {
    font-size: var(--font-body--size-small);
    margin-bottom: var(--padding-xs);
    line-height: normal;
  }

  .cross-sell__select {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* .cross-sell__select:not(.hidden):not(:last-child) {
    margin-right: var(--padding-sm);
  } */

  .cross-sell-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 8px;
  }

  .cross-sell-dot {
    width: 20px;
    height: 3px;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: #ccc;
    cursor: pointer;
  }

  .cross-sell-dot.is-active {
    background: #000;
  }

  @media screen and (max-width: 749px) {
    .cross-sell {
      grid-template-columns: auto 1fr;
      grid-template-areas: 'image content' 'image actions';
    }
    .cross-sell__actions {
      justify-content: flex-start;
      margin-top: var(--gap-xxs);
    }
  }

  @media screen and (min-width: 750px) {
    .cross-sell__actions {
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:cross_sell",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "show_on_display",
      "label": "t:show_on_display",
      "default": "desktop_and_mobile",
      "options": [
        { "value": "desktop_and_mobile", "label": "t:desktop_and_mobile" },
        { "value": "desktop_only", "label": "t:desktop_only" },
        { "value": "mobile_only", "label": "t:mobile_only" }
      ]
    },
    {
      "type": "header",
      "content": "t:style"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "t:display_mode",
      "default": "row",
      "options": [
        {
          "value": "row",
          "label": "t:row"
        },
        {
          "value": "column",
          "label": "t:column"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_card_border",
      "label": "t:show_card_border",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "t:products",
      "info": "t:cross_sell_products_info"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:title_optional"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:description_optional"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:show_image",
      "default": true
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "t:image_width",
      "default": 75,
      "min": 60,
      "max": 90,
      "step": 5,
      "unit": "px",
      "visible_if": "{{ block.settings.show_image }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:image_optional",
      "info": "t:image_cross_sell_optional_info",
      "visible_if": "{{ block.settings.show_image }}"
    },
    {
      "type": "checkbox",
      "id": "show_options_label",
      "label": "t:show_options_label",
      "default": false
    },
    {
      "type": "select",
      "id": "price_position",
      "label": "t:cross_sell_price_position",
      "options": [
        { "value": "next_to_title", "label": "t:next_to_title" },
        { "value": "below_title", "label": "t:below_title" },
        { "value": "inside_cart_add_button", "label": "t:inside_cart_add_button" }
      ],
      "default": "next_to_title"
    },
    {
      "type": "select",
      "id": "button_content_type",
      "label": "t:button_content_type",
      "options": [
        { "value": "text", "label": "t:text" },
        { "value": "icon", "label": "t:icon" }
      ],
      "default": "text"
    },
    {
      "type": "select",
      "id": "button_content_icon",
      "label": "t:icon",
      "options": [
        { "value": "local_mall", "label": "t:icons_list.local_mall" },
        { "value": "garden_cart", "label": "t:icons_list.garden_cart" },
        { "value": "shopping_cart", "label": "t:icons_list.shopping_cart" },
        { "value": "shop", "label": "t:icons_list.shop" },
        { "value": "work", "label": "t:icons_list.work" },
        { "value": "money_bag", "label": "t:icons_list.money_bag" },
        { "value": "luggage", "label": "t:icons_list.luggage" },
        { "value": "shopping_bag", "label": "t:icons_list.shopping_bag" },
        { "value": "shopping_basket", "label": "t:icons_list.shopping_basket" },
        { "value": "shopping_bag_speed", "label": "t:icons_list.shopping_bag_speed" },
        { "value": "store", "label": "t:icons_list.store" },
        { "value": "storefront", "label": "t:icons_list.storefront" },
        { "value": "add", "label": "t:icons_list.add" },
        { "value": "bolt", "label": "t:icons_list.bolt" }
      ],
      "default": "add",
      "visible_if": "{{ block.settings.button_content_type == 'icon' }}"
    },
    {
      "type": "header",
      "content": "t:margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:margin_top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:margin_bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:advanced_settings"
    },
    {
      "type": "text",
      "id": "additional_class",
      "label": "t:additional_class",
      "info": "t:additional_class_info"
    },
    {
      "type": "header",
      "content": "t:go_further"
    },
    {
      "type": "paragraph",
      "content": "t:go_further_description"
    }
  ],
  "presets": [
    {
      "name": "t:cross_sell",
      "category": "t:cross_sell_and_upsell"
    },
    {
      "name": "t:cross_sell_column",
      "category": "t:cross_sell_and_upsell",
      "settings": {
        "display_mode": "column"
      }
    },
    {
      "name": "t:up_sell",
      "category": "t:cross_sell_and_upsell",
      "settings": {
        "title": "t:cross_sell_bundle_title_default",
        "description": "t:cross_sell_bundle_description_default"
      }
    }
  ]
}
{% endschema %}
