{% schema %}
{
  "name": "t:cart_drawer",
  "class": "cart-drawer",
  "settings": [
    {
      "type": "select",
      "id": "cart_style",
      "label": "t:cart_drawer_style",
      "options": [
        {
          "value": "defaut",
          "label": "t:default"
        },
        {
          "value": "floating",
          "label": "t:floating"
        },
        {
          "value": "rounded",
          "label": "t:rounded"
        }
      ],
      "default": "floating"
    },
    {
      "type": "select",
      "id": "cart_drawer_width_on_desktop",
      "label": "t:cart_drawer_width_on_desktop",
      "options": [
        { "value": "440", "label": "t:default" },
        { "value": "490", "label": "t:larger" },
        { "value": "550", "label": "t:largest" }
      ],
      "default": "440"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:full_width_on_mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "products_media_ratio",
      "label": "t:products_media_ratio",
      "options": [
        { "value": "1 / 1", "label": "t:square" },
        { "value": "4 / 5", "label": "t:portrait" },
        { "value": "4 / 3", "label": "t:landscape" },
        { "value": "adapt", "label": "t:adapt" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "show_variant_options_labels",
      "label": "t:show_variant_options_labels",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_remove_button",
      "label": "t:show_remove_button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_count",
      "label": "t:show_cart_count",
      "default": true
    },
    {
      "type": "header",
      "content": "t:color_scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_header",
      "label": "t:color_scheme_cart_header",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_body",
      "label": "t:color_scheme_cart_body",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_elements",
      "label": "t:color_scheme_cart_elements",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_footer",
      "label": "t:color_scheme_cart_footer",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:go_further"
    },
    {
      "type": "paragraph",
      "content": "t:go_further_description"
    }
  ]
}
{% endschema %}