<section class="comparison-table-section">
  <div class="comparison-table-wrapper">

    {% if section.settings.heading != blank %}
      <h2 class="comparison-table-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="comparison-table-subheading">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    <div class="comparison-table">

      <div class="comparison-table-header">
        <div></div>

        <div class="brand-col">
          {{ section.settings.brand_column }}
        </div>

        <div class="classic-col">
          {{ section.settings.classic_column }}
        </div>
      </div>

      {% for block in section.blocks %}
        <div class="comparison-table-row" {{ block.shopify_attributes }}>

          <div class="comparison-label">
            {{ block.settings.label }}
          </div>

          <div class="comparison-value brand-value">
            <span class="check-icon">✓</span>
            <span>{{ block.settings.brand_text }}</span>
          </div>

          <div class="comparison-value classic-value">
            <span class="minus-icon">–</span>
            <span>{{ block.settings.classic_text }}</span>
          </div>

        </div>
      {% endfor %}

    </div>
  </div>
</section>

<style>
.comparison-table-section {
  padding: 80px 20px;
  background: #f6f8f7;
}

.comparison-table-wrapper {
  max-width: 1100px;
  margin: 0 auto;
}

.comparison-table-heading {
  text-align: center;
  font-size: clamp(32px, 5vw, 52px);
  line-height: 1.1;
  font-weight: 700;
  color: #111;
  margin-bottom: 16px;
}

.comparison-table-subheading {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 50px;
  color: #5f5f5f;
  font-size: 17px;
  line-height: 1.7;
}

.comparison-table {
  background: white;
  border-radius: 28px;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,0.08);
  box-shadow: 0 20px 50px rgba(0,0,0,0.05);
}

.comparison-table-header,
.comparison-table-row {
  display: grid;
  grid-template-columns: 1.1fr 1fr 1fr;
}

.comparison-table-header {
  background: #edf2ef;
}

.comparison-table-header > div,
.comparison-table-row > div {
  padding: 24px;
}

.brand-col {
  background: #556b5d;
  color: white;
  text-align: center;
  font-weight: 700;
}

.classic-col {
  text-align: center;
  font-weight: 700;
  color: #333;
}

.comparison-table-row {
  border-top: 1px solid rgba(0,0,0,0.07);
  align-items: center;
}

.comparison-label {
  font-weight: 600;
  color: #222;
}

.comparison-value {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  text-align: center;
  color: #444;
  line-height: 1.5;
}

.check-icon {
  width: 26px;
  height: 26px;
  min-width: 26px;
  border-radius: 999px;
  background: #556b5d;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.minus-icon {
  width: 26px;
  height: 26px;
  min-width: 26px;
  border-radius: 999px;
  background: #e5e5e5;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

@media screen and (max-width: 768px) {

  .comparison-table-header {
    display: none;
  }

  .comparison-table-row {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
  }

  .comparison-table-row > div {
    padding: 0;
    width: 100%;
  }

  .comparison-label {
    font-size: 18px;
    margin-bottom: 8px;
  }

  .comparison-value {
    justify-content: flex-start;
    text-align: left;
    padding: 16px !important;
    border-radius: 16px;
  }

  .brand-value {
    background: #f7faf8;
  }

  .classic-value {
    background: #fafafa;
  }
}
</style>
{% schema %}
{
  "name": "Tableau comparatif",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Manger maison sans compliquer la journée"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Un sac pensé pour transporter un repas, une boisson et les essentiels du quotidien plus facilement."
    },
    {
      "type": "text",
      "id": "brand_column",
      "label": "Colonne marque",
      "default": "Sac isotherme repas"
    },
    {
      "type": "text",
      "id": "classic_column",
      "label": "Colonne comparaison",
      "default": "Sac classique"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Critère",
          "default": "Organisation du repas"
        },
        {
          "type": "text",
          "id": "brand_text",
          "label": "Texte colonne marque",
          "default": "Compartiment pensé pour lunch box, gourde et accessoires"
        },
        {
          "type": "text",
          "id": "classic_text",
          "label": "Texte colonne comparaison",
          "default": "Espace moins adapté au transport d’un repas"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tableau comparatif",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Budget du midi",
            "brand_text": "Permet d’emporter un repas préparé à la maison",
            "classic_text": "Pousse plus facilement à acheter dehors"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Transport du repas",
            "brand_text": "Format adapté aux lunch box et contenants repas",
            "classic_text": "Repas moins bien organisé dans le sac"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Maintien de la température",
            "brand_text": "Conception isotherme pour limiter les variations de température",
            "classic_text": "Aucun maintien spécifique"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Usage quotidien",
            "brand_text": "Pratique pour le travail, les cours ou les déplacements",
            "classic_text": "Moins pensé pour les repas nomades"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Organisation",
            "brand_text": "Permet de séparer repas, boisson et petits accessoires",
            "classic_text": "Tout se mélange plus facilement"
          }
        }
      ]
    }
  ]
}
{% endschema %}