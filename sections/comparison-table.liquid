<section class="comparison-table-section">
  <div class="comparison-table-wrapper">

    <h2 class="comparison-table-heading">
      {{ section.settings.heading }}
    </h2>

    <p class="comparison-table-subheading">
      {{ section.settings.subheading }}
    </p>

    <div class="comparison-table">
      <div class="comparison-table-header">
        <div></div>

        <div class="comparison-table-head active">
          <span class="head-icon">❄</span>
          <span>{{ section.settings.brand_column }}</span>
        </div>

        <div class="comparison-table-head">
          <span class="head-icon">□</span>
          <span>{{ section.settings.classic_column }}</span>
        </div>
      </div>

      {% assign has_blocks = false %}
      {% for block in section.blocks %}
        {% assign has_blocks = true %}
      {% endfor %}

      {% if has_blocks %}
        {% for block in section.blocks %}
          <div class="comparison-table-row" {{ block.shopify_attributes }}>
            <div class="comparison-label">
              <span class="label-icon">{{ block.settings.icon }}</span>
              <strong>{{ block.settings.label }}</strong>
            </div>

            <div class="comparison-value">
              <span class="check-icon">✓</span>
              <span>{{ block.settings.brand_text }}</span>
            </div>

            <div class="comparison-value">
              <span class="cross-icon">×</span>
              <span>{{ block.settings.classic_text }}</span>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="comparison-table-row">
          <div class="comparison-label"><span class="label-icon">💼</span><strong>Contrôle du budget</strong></div>
          <div class="comparison-value"><span class="check-icon">✓</span><span>Tu prépares à l’avance et tu évites les achats impulsifs à l’extérieur.</span></div>
          <div class="comparison-value"><span class="cross-icon">×</span><span>Tu dépenses plus facilement en options de dernière minute.</span></div>
        </div>

        <div class="comparison-table-row">
          <div class="comparison-label"><span class="label-icon">🌱</span><strong>Contrôle de son alimentation</strong></div>
          <div class="comparison-value"><span class="check-icon">✓</span><span>Tu choisis des repas adaptés à tes besoins et à ton rythme.</span></div>
          <div class="comparison-value"><span class="cross-icon">×</span><span>Tu maîtrises moins la qualité et la composition de tes repas.</span></div>
        </div>

        <div class="comparison-table-row">
          <div class="comparison-label"><span class="label-icon">🕒</span><strong>Meilleure organisation</strong></div>
          <div class="comparison-value"><span class="check-icon">✓</span><span>Ton repas est prêt, rangé et facile à emporter avant de partir.</span></div>
          <div class="comparison-value"><span class="cross-icon">×</span><span>Tu perds du temps à décider quoi acheter au dernier moment.</span></div>
        </div>

        <div class="comparison-table-row">
          <div class="comparison-label"><span class="label-icon">🧘</span><strong>Plus de liberté au quotidien</strong></div>
          <div class="comparison-value"><span class="check-icon">✓</span><span>Tu avances dans ta journée sans dépendre des options autour de toi.</span></div>
          <div class="comparison-value"><span class="cross-icon">×</span><span>Tu dépends davantage de ce qui est disponible sur place.</span></div>
        </div>

        <div class="comparison-table-row">
          <div class="comparison-label"><span class="label-icon">🍃</span><strong>Moins d’emballages jetables</strong></div>
          <div class="comparison-value"><span class="check-icon">✓</span><span>Tu limites les emballages liés aux repas achetés à l’extérieur.</span></div>
          <div class="comparison-value"><span class="cross-icon">×</span><span>Les repas à emporter ajoutent souvent plus d’emballages.</span></div>
        </div>
      {% endif %}
    </div>

    <div class="comparison-bottom-icons">
      <div class="bottom-item">
        <span>🛡️</span>
        <p>Conserve la fraîcheur<br>plus longtemps</p>
      </div>
      <div class="bottom-item">
        <span>💧</span>
        <p>Étanche et facile<br>à nettoyer</p>
      </div>
      <div class="bottom-item">
        <span>🪶</span>
        <p>Léger et confortable<br>à transporter</p>
      </div>
      <div class="bottom-item">
        <span>♡</span>
        <p>Pensé pour ton<br>quotidien actif</p>
      </div>
    </div>

  </div>
</section>

<style>
.comparison-table-section {
  background: #fbfaf7;
padding: 30px 20px 10px;
}

.comparison-table-wrapper {
max-width: 1600px;
  margin: 0 auto;
  transform: scale(0.82);
  transform-origin: top center;
}

.comparison-table-heading {
  text-align: center;
  font-size: clamp(28px, 4vw, 44px);
  line-height: 1.08;
  font-weight: 750;
  color: #101814;
  margin: 0 0 12px;
}

.comparison-table-subheading {
  text-align: center;
  max-width: 620px;
  margin: 0 auto 38px;
  color: #555;
  font-size: 16px;
  line-height: 1.55;
}

.comparison-table {
  background: #fff;
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: 22px;
  overflow: hidden;
  box-shadow: 0 18px 45px rgba(0,0,0,0.045);
}

.comparison-table-header,
.comparison-table-row {
  display: grid;
  grid-template-columns: 1fr 1.2fr 1.2fr;
}

.comparison-table-header {
  background: #f2f3ef;
}

.comparison-table-header > div,
.comparison-table-row > div {
padding: 16px 20px;
}

.comparison-table-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  font-weight: 750;
  color: #111;
  font-size: 17px;
}

.comparison-table-head.active {
  background: #526b5b;
  color: #fff;
}

.head-icon {
  width: 38px;
  height: 38px;
  border: 2px solid currentColor;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
}

.comparison-table-row {
  border-top: 1px solid rgba(0,0,0,0.075);
  align-items: center;
}

.comparison-label {
  display: flex;
  align-items: center;
  gap: 18px;
  color: #111;
  font-size: 16px;
}

.label-icon {
  width: 46px;
  height: 46px;
  border-radius: 999px;
  background: #edf3ed;
  border: 1px solid #c8d6c8;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 21px;
  flex-shrink: 0;
}

.comparison-value {
  display: flex;
  align-items: center;
  gap: 18px;
  color: #303030;
  line-height: 1.45;
  font-size: 16px;
}

.check-icon,
.cross-icon {
  width: 30px;
  height: 30px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 750;
  flex-shrink: 0;
}

.check-icon {
  background: #e8f0e3;
  color: #526b5b;
}

.cross-icon {
  background: #ececec;
  color: #555;
  font-size: 21px;
}

.comparison-bottom-icons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  max-width: 960px;
  margin: 28px auto 0;
}

.bottom-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 0 22px;
  border-right: 1px solid rgba(0,0,0,0.12);
}

.bottom-item:last-child {
  border-right: none;
}

.bottom-item span {
  font-size: 28px;
  line-height: 1;
}

.bottom-item p {
  margin: 0;
  font-size: 14px;
  line-height: 1.35;
  color: #333;
}

@media screen and (max-width: 768px) {
  .comparison-table-section {
    padding: 42px 14px 34px;
  }

  .comparison-table-heading {
    font-size: 28px;
  }

  .comparison-table-subheading {
    font-size: 15px;
    margin-bottom: 28px;
  }

  .comparison-table-header {
    display: none;
  }

  .comparison-table-row {
    display: block;
    padding: 22px;
  }

  .comparison-table-row > div {
    padding: 0;
  }

  .comparison-label {
    margin-bottom: 16px;
    font-size: 16px;
  }

  .comparison-value {
    padding: 14px 0;
    font-size: 15px;
    gap: 12px;
  }

  .comparison-value:nth-child(2) {
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  .comparison-bottom-icons {
    grid-template-columns: 1fr 1fr;
    gap: 18px 0;
    margin-top: 24px;
  }

  .bottom-item {
    border-right: none;
    justify-content: flex-start;
    padding: 0 10px;
  }

  .bottom-item p {
    font-size: 13px;
  }
}
</style>

{% schema %}
{
  "name": "Tableau comparatif",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Manger maison, plus simple au quotidien"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Un sac isotherme pensé pour transporter ton repas, ta boisson et les essentiels, où que tu ailles."
    },
    {
      "type": "text",
      "id": "brand_column",
      "label": "Colonne produit",
      "default": "Sac isotherme repas"
    },
    {
      "type": "text",
      "id": "classic_column",
      "label": "Colonne comparaison",
      "default": "Sans sac adapté"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icône",
          "default": "💼"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Critère",
          "default": "Contrôle du budget"
        },
        {
          "type": "textarea",
          "id": "brand_text",
          "label": "Texte colonne produit",
          "default": "Tu prépares à l’avance et tu évites les achats impulsifs à l’extérieur."
        },
        {
          "type": "textarea",
          "id": "classic_text",
          "label": "Texte colonne comparaison",
          "default": "Tu dépenses plus facilement en options de dernière minute."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tableau comparatif"
    }
  ]
}
{% endschema %}