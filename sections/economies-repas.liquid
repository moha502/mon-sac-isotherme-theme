{% liquid
  assign section_id = 'economies-repas-' | append: section.id
%}

<section id="{{ section_id }}" class="economies-repas section section--padding">
  <div class="page-width">
    <div class="economies-repas__intro">
      <p class="economies-repas__badge badge badge--primary">{{ section.settings.badge_text }}</p>
      <h2 class="economies-repas__title h0">
        {{ section.settings.title_line_1 }}
        <span>{{ section.settings.title_line_2 }}</span>
      </h2>
      <p class="economies-repas__subtitle rte">{{ section.settings.subtitle }}</p>
    </div>

    <div class="economies-repas__stats">
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          <div class="economies-repas__stat" {{ block.shopify_attributes }}>
            <p class="economies-repas__stat-value">{{ block.settings.value }}</p>
            <p class="economies-repas__stat-main">{{ block.settings.main_line }}</p>
            <p class="economies-repas__stat-sub">{{ block.settings.sub_line }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="economies-repas__lifestyle">
      <div class="economies-repas__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 990px) 50vw, 100vw', class: 'economies-repas__image', alt: section.settings.image.alt | escape }}
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <div class="economies-repas__content">
        <p class="economies-repas__label">{{ section.settings.label }}</p>
        <h3 class="economies-repas__content-title">{{ section.settings.content_title }}</h3>

        <ul class="economies-repas__benefits" role="list">
          {% for i in (1..3) %}
            {% assign key = 'benefit_' | append: i %}
            {% assign benefit = section.settings[key] %}
            {% if benefit != blank %}
              <li>{{ benefit }}</li>
            {% endif %}
          {% endfor %}
        </ul>

        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="button button--primary economies-repas__cta">
            {{ section.settings.button_label }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="economies-repas__transition" aria-hidden="true">
      <span class="economies-repas__curve"></span>
      <span class="economies-repas__arrow-wrap">↓</span>
      <p>{{ section.settings.transition_text }}</p>
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    --accent: var(--color-primary-button-background);
  }

  #{{ section_id }} .page-width {
    max-width: 112rem;
  }

  #{{ section_id }} .economies-repas__intro {
    text-align: center;
    max-width: 78rem;
    margin: 0 auto;
  }

  #{{ section_id }} .economies-repas__badge {
    display: inline-flex;
    margin-bottom: 0.8rem;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    letter-spacing: 0.06em;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  #{{ section_id }} .economies-repas__title {
    margin: 0;
    font-size: clamp(2.4rem, 3.4vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: rgb(var(--color-foreground));
  }

  #{{ section_id }} .economies-repas__title span {
    display: block;
    color: var(--accent);
  }

  #{{ section_id }} .economies-repas__subtitle {
    margin: 1rem auto 0;
    max-width: 62rem;
    color: rgba(var(--color-foreground), 0.75);
    font-size: 1.35rem;
    line-height: 1.45;
  }

  #{{ section_id }} .economies-repas__stats {
    margin-top: 1.8rem;
    background: var(--color-background);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 1.8rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
  }

  #{{ section_id }} .economies-repas__stat {
    text-align: center;
    padding: 1.6rem 1.2rem;
    position: relative;
  }

  #{{ section_id }} .economies-repas__stat:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 18%;
    right: 0;
    width: 1px;
    height: 64%;
    background: rgba(var(--color-foreground), 0.1);
  }

  #{{ section_id }} .economies-repas__stat-value {
    margin: 0;
    font-weight: 700;
    font-size: clamp(2.8rem, 3vw, 4rem);
    line-height: 1;
  }

  #{{ section_id }} .economies-repas__stat-value::after {
    content: "";
    display: block;
    width: 2.6rem;
    height: 0.35rem;
    margin: 0.55rem auto 0.75rem;
    border-radius: 999px;
    background: var(--accent);
  }

  #{{ section_id }} .economies-repas__stat-main {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.25;
    font-weight: 600;
  }

  #{{ section_id }} .economies-repas__stat-sub {
    margin: 0.45rem 0 0;
    font-size: 1.15rem;
    color: rgba(var(--color-foreground), 0.7);
  }

  #{{ section_id }} .economies-repas__lifestyle {
    margin-top: 1.6rem;
    border-radius: 1.8rem;
    background: color-mix(in srgb, var(--color-background) 95%, var(--accent) 5%);
    border: 1px solid rgba(var(--color-foreground), 0.06);
    padding: 1.8rem;
    display: grid;
    grid-template-columns: 0.95fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  #{{ section_id }} .economies-repas__media {
    border-radius: 1.4rem;
    overflow: hidden;
  }

  #{{ section_id }} .economies-repas__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    max-height: 22rem;
  }

  #{{ section_id }} .economies-repas__label {
    margin: 0 0 0.7rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 1.1rem;
  }

  #{{ section_id }} .economies-repas__content-title {
    margin: 0 0 1.2rem;
    font-size: clamp(2rem, 2.8vw, 3.2rem);
    line-height: 1.08;
  }

  #{{ section_id }} .economies-repas__benefits {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }

  #{{ section_id }} .economies-repas__benefits li {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    font-size: 1.25rem;
  }

  #{{ section_id }} .economies-repas__benefits li::before {
    content: "•";
    color: var(--accent);
    font-size: 1.8rem;
    line-height: 1;
  }

  #{{ section_id }} .economies-repas__cta {
    margin-top: 1.4rem;
  }

  #{{ section_id }} .economies-repas__transition {
    margin-top: 1.2rem;
    text-align: center;
    position: relative;
    padding-top: 1.2rem;
  }

  #{{ section_id }} .economies-repas__curve {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    border-top: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
  }

  #{{ section_id }} .economies-repas__arrow-wrap {
    width: 4.6rem;
    height: 4.6rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin: 0 auto 0.4rem;
    background: color-mix(in srgb, var(--accent) 10%, var(--color-background));
    color: var(--accent);
    font-size: 2rem;
  }

  #{{ section_id }} .economies-repas__transition p {
    margin: 0;
    color: var(--accent);
    font-size: 1.2rem;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .economies-repas__stats,
    #{{ section_id }} .economies-repas__lifestyle {
      grid-template-columns: 1fr;
    }

    #{{ section_id }} .economies-repas__stat:not(:last-child)::after {
      display: none;
    }

    #{{ section_id }} .economies-repas__stat {
      padding: 1.3rem 1rem;
    }

    #{{ section_id }} .economies-repas__image {
      max-height: 18rem;
    }
  }
</style>