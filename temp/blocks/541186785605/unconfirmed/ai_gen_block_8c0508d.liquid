{% doc %}
  @prompt
    description reprenant le contenue du référencement naturel seo de la collection , supprime le titre en haut et réduit considérablement la taille du contenue c enorme et moche , réduit énormement la taille et colle a gauche 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-seo-description-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-collection-seo-description__inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0;
  }

  .ai-collection-seo-description__meta-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.meta_spacing }}px;
    color: {{ block.settings.meta_color }};
    font-size: {{ block.settings.meta_size }}px;
    line-height: 1.4;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-collection-seo-description__content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.4;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-collection-seo-description__content-{{ ai_gen_id }} p {
    margin: 0 0 8px;
  }

  .ai-collection-seo-description__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-collection-seo-description__empty-{{ ai_gen_id }} {
    padding: 15px;
    text-align: left;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    font-style: italic;
    font-size: 11px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-seo-description-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-collection-seo-description__meta-{{ ai_gen_id }} {
      font-size: {{ block.settings.meta_size_mobile }}px;
    }

    .ai-collection-seo-description__content-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-collection-seo-description-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-seo-description__inner-{{ ai_gen_id }}">
    {% if collection %}
      {% if block.settings.show_meta_description and collection.metafields.descriptor.general.value.description != blank %}
        <div class="ai-collection-seo-description__meta-{{ ai_gen_id }}">
          {{ collection.metafields.descriptor.general.value.description }}
        </div>
      {% endif %}

      {% if collection.description != blank %}
        <div class="ai-collection-seo-description__content-{{ ai_gen_id }}">
          {{ collection.description }}
        </div>
      {% else %}
        <div class="ai-collection-seo-description__empty-{{ ai_gen_id }}">
          Ajoutez une description à cette collection
        </div>
      {% endif %}
    {% else %}
      <div class="ai-collection-seo-description__empty-{{ ai_gen_id }}">
        Ce bloc affichera la description de la collection
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Description collection",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "checkbox",
      "id": "show_meta_description",
      "label": "Afficher la meta",
      "default": false,
      "info": "Affiche la meta description SEO si disponible"
