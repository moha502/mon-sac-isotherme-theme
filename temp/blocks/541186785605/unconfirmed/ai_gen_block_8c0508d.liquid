    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Taille texte",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Taille texte mobile",
      "min": 10,
