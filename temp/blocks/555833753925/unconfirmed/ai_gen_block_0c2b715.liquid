        <div class="ai-icon-feature-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-icon-feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            {% case block.settings.feature_3_icon %}
              {% when 'check' %}
                <polyline points="20 6 9 17 4 12"></polyline>
              {% when 'truck' %}
