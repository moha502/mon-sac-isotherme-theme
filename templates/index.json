        "text_G4M7mq": {
          "type": "text",
          "name": "t:title",
          "settings": {
            "show_on_display": "desktop_and_mobile",
            "text": "<p>Pourquoi ce site existe ?</p>",
            "text_style": "h2",
            "paragraph_font_size": "normal",
            "font_weight": 400,
            "alignment": "center",
            "alignment_mobile": "center",
            "show_read_more": false,
